#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Minimal directory-backed Sahara image loader for M2172 SDX55M bring-up."""

import argparse
import os
import select
import struct
import sys
import time

CMD_HELLO = 1
CMD_HELLO_RESP = 2
CMD_READ_DATA = 3
CMD_END_IMAGE = 4
CMD_DONE = 5
CMD_DONE_RESP = 6
CMD_RESET = 7
CMD_RESET_RESP = 8
CMD_MEMORY_DEBUG = 9
CMD_MEMORY_READ = 10
CMD_CMD_READY = 11
CMD_SWITCH_MODE = 12
CMD_EXEC = 13
CMD_EXEC_RESP = 14
CMD_EXEC_DATA = 15
CMD_MEMORY_DEBUG64 = 16
CMD_MEMORY_READ64 = 17

SAHARA_COMMAND_SUPPORTED_COMMANDS = 8

HELLO_LEN = 48

IMAGE_FILES = {
    6: "apps.mbn",
    8: "qdsp6sw.mbn",
    9: "mdmddr.mbn",           # alias id, same file as 34
    16: "efs1.bin",        # seeded from store (m9kefs1) at bringup
    17: "efs2.bin",
    20: "efs3.bin",
    21: "sbl1.mbn",
    23: "rpm.mbn",         # SDX50M: id 23 = rpm (not aop)
    25: "tz.mbn",
    29: "acdb.mbn",
    31: "mba.mbn",
    34: "mdmddr.mbn",
}


def log(tag, message):
    print(f"[{time.strftime('%H:%M:%S')}] {tag}: {message}", flush=True)


def words(data):
    usable = len(data) - len(data) % 4
    if usable <= 0:
        return ()
    return struct.unpack(f"<{usable // 4}I", data[:usable])


def words_head(data, count=16):
    packet_words = words(data)
    suffix = "..." if len(packet_words) > count else ""
    return f"{packet_words[:count]}{suffix} count={len(packet_words)}"


def read_packet(fd, timeout, read_size):
    deadline = time.monotonic() + timeout
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return b""
        readable, _, _ = select.select([fd], [], [], min(remaining, 1.0))
        if not readable:
            continue
        try:
            return os.read(fd, read_size)
        except BlockingIOError:
            continue


def write_all(fd, data, timeout):
    view = memoryview(data)
    written = 0
    deadline = time.monotonic() + timeout
    while written < len(data):
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError(f"write timeout after {written}/{len(data)} bytes")
        _, writable, _ = select.select([], [fd], [], min(remaining, 1.0))
        if not writable:
            continue
        try:
            written += os.write(fd, view[written:])
        except BlockingIOError:
            continue
    return written


def send_hello_resp(fd, hello_words, args):
    version = hello_words[2] if len(hello_words) > 2 else 2
    compatible = hello_words[3] if args.hello_compat < 0 and len(hello_words) > 3 else args.hello_compat
    mode = hello_words[5] if args.hello_mode < 0 and len(hello_words) > 5 else args.hello_mode
    packet = struct.pack("<12I", CMD_HELLO_RESP, HELLO_LEN, version, compatible,
                         0, mode, 0, 0, 0, 0, 0, 0)
    write_all(fd, packet, args.write_timeout)
    log("tx", f"HELLO_RESP version={version} compatible={compatible} mode={mode}")


def send_done(fd, args):
    write_all(fd, struct.pack("<2I", CMD_DONE, 8), args.write_timeout)
    log("tx", "DONE")


def send_reset(fd, args):
    write_all(fd, struct.pack("<2I", CMD_RESET, 8), args.write_timeout)
    log("tx", "RESET")


def send_switch_mode(fd, mode, args):
    write_all(fd, struct.pack("<3I", CMD_SWITCH_MODE, 12, mode), args.write_timeout)
    log("tx", f"CMD_SWITCH_MODE mode={mode}")


def send_cmd_exec(fd, command, args):
    write_all(fd, struct.pack("<3I", CMD_EXEC, 12, command), args.write_timeout)
    log("tx", f"CMD_EXEC command={command}")


def send_cmd_exec_data(fd, command, args):
    write_all(fd, struct.pack("<3I", CMD_EXEC_DATA, 12, command), args.write_timeout)
    log("tx", f"CMD_EXEC_DATA command={command}")


def send_memory_read(fd, address, length, is64, args):
    if is64:
        packet = struct.pack("<IIQQ", CMD_MEMORY_READ64, 24, address, length)
    else:
        packet = struct.pack("<IIII", CMD_MEMORY_READ, 16,
                             address & 0xffffffff, length & 0xffffffff)
    write_all(fd, packet, args.write_timeout)
    log("tx", f"MEMORY_READ{'64' if is64 else ''} address=0x{address:x} length={length}")


def queue_cmd_exec(args, command):
    command &= 0xff
    if command == 0:
        log("cmd_queue", "ignore command=0")
        return
    if command in args.cmd_exec_queue:
        log("cmd_queue", f"command={command} already queued")
        return
    if len(args.cmd_exec_queue) >= args.max_cmd_queue:
        raise RuntimeError(f"command queue full while adding {command}")
    args.cmd_exec_queue.append(command)
    log("cmd_queue", f"queued command={command} depth={len(args.cmd_exec_queue)}")


def run_next_cmd_or_switch(fd, args):
    if args.cmd_exec_queue:
        command = args.cmd_exec_queue.pop()
        count = args.cmd_exec_counts.get(command, 0) + 1
        args.cmd_exec_counts[command] = count
        if count > args.max_cmd_execs:
            raise RuntimeError(f"command {command} exceeded max exec count")
        args.current_cmd_exec = command
        send_cmd_exec(fd, command, args)
        return

    args.current_cmd_exec = None
    if args.switch_after_cmds and not args.command_switch_sent:
        args.command_switch_sent = True
        send_switch_mode(fd, 0, args)


def firmware_path(args, image):
    name = IMAGE_FILES.get(image)
    if not name:
        raise RuntimeError(f"unsupported image id {image}")
    return os.path.join(args.firmware_dir, name)


def cstr(raw):
    return raw.split(b"\0", 1)[0].decode("ascii", "replace")


def safe_name(name, fallback):
    cleaned = "".join(ch if ch.isalnum() or ch in "._-" else "_" for ch in name)
    return cleaned.strip("._") or fallback


def parse_memory_table(data, is64):
    entries = []
    entry_size = 64 if is64 else 52
    if len(data) % entry_size:
        raise RuntimeError(f"unaligned memory table length={len(data)} entry_size={entry_size}")

    for index, offset in enumerate(range(0, len(data), entry_size)):
        if is64:
            save_pref, base, length = struct.unpack_from("<QQQ", data, offset)
            desc = cstr(data[offset + 24:offset + 44])
            name = cstr(data[offset + 44:offset + 64])
        else:
            save_pref, base, length = struct.unpack_from("<III", data, offset)
            desc = cstr(data[offset + 12:offset + 32])
            name = cstr(data[offset + 32:offset + 52])

        entries.append({
            "index": index,
            "save_pref": save_pref,
            "base": base,
            "address": base,
            "length": length,
            "remaining": length,
            "desc": desc,
            "name": name,
        })
    return entries


def memory_path(args, entry):
    os.makedirs(args.mem_dump_dir, exist_ok=True)
    name = safe_name(entry["name"], f"region{entry['index']}.bin")
    if args.mem_prefix:
        name = f"{safe_name(args.mem_prefix, 'mhi')}_{name}"
    return os.path.join(args.mem_dump_dir, name)


def start_next_memory_read(fd, args):
    while args.memory_entries:
        entry = args.memory_entries[-1]
        if entry["remaining"] <= 0:
            log("mem", f"complete index={entry['index']} name={entry['name']} path={entry['path']}")
            args.memory_entries.pop()
            continue

        length = min(entry["remaining"], args.chunk_size)
        args.memory_current = entry
        args.memory_region_remaining = length
        send_memory_read(fd, entry["address"], length, args.memory_is64, args)
        return "progress", 0

    args.memory_current = None
    if args.reset_after_memory:
        send_reset(fd, args)
        return "progress", 0
    return "stop", 0


def handle_memory_table_data(fd, data, args):
    take = min(args.memory_table_remaining, len(data))
    args.memory_table_parts.append(data[:take])
    args.memory_table_remaining -= take
    log("mem_table", f"chunk={take} remaining={args.memory_table_remaining}")

    if len(data) > take:
        raise RuntimeError("memory table read exceeded expected length")

    if args.memory_table_remaining:
        return "progress", 0

    table = b"".join(args.memory_table_parts)
    entries = parse_memory_table(table, args.memory_is64)
    args.memory_entries = entries[:]
    for entry in entries:
        entry["path"] = memory_path(args, entry)
        open(entry["path"], "wb").close()
        log("mem_table",
            f"entry={entry['index']} save_pref={entry['save_pref']} "
            f"base=0x{entry['base']:x} length={entry['length']} "
            f"desc={entry['desc']!r} name={entry['name']!r} path={entry['path']}")

    args.memory_table_parts = []
    return start_next_memory_read(fd, args)


def handle_memory_region_data(fd, data, args):
    entry = args.memory_current
    if not entry:
        raise RuntimeError("memory region data arrived without active entry")

    take = min(args.memory_region_remaining, len(data))
    with open(entry["path"], "r+b", buffering=0) as fp:
        fp.seek(entry["address"] - entry["base"])
        fp.write(data[:take])

    args.memory_region_remaining -= take
    entry["remaining"] -= take
    entry["address"] += take
    log("mem",
        f"entry={entry['index']} chunk={take} "
        f"entry_remaining={entry['remaining']} request_remaining={args.memory_region_remaining}")

    if len(data) > take:
        raise RuntimeError("memory region read exceeded expected length")

    if args.memory_region_remaining:
        return "progress", 0

    if entry["remaining"]:
        return start_next_memory_read(fd, args)

    return start_next_memory_read(fd, args)


def send_image_range(fd, image, offset, length, args):
    path = firmware_path(args, image)
    size = os.path.getsize(path)
    if args.max_request > 0 and length > args.max_request:
        raise RuntimeError(
            f"request too large image={image} length={length} "
            f"max_request={args.max_request}"
        )
    if offset + length > size:
        raise RuntimeError(
            f"request exceeds firmware image={image} offset={offset} "
            f"length={length} size={size} path={path}"
        )

    log("read_data", f"image={image} offset={offset} length={length} source={path}")
    sent = 0
    with open(path, "rb", buffering=0) as file:
        file.seek(offset)
        remaining = length
        while remaining:
            chunk = file.read(min(args.chunk_size, remaining))
            if not chunk:
                raise RuntimeError(f"short read {path}")
            write_all(fd, chunk, args.write_timeout)
            sent += len(chunk)
            remaining -= len(chunk)
    log("tx", f"image={image} bytes={sent}")
    return sent


def handle_packet(fd, data, args):
    if getattr(args, "memory_table_remaining", 0):
        return handle_memory_table_data(fd, data, args)

    if getattr(args, "memory_region_remaining", 0):
        return handle_memory_region_data(fd, data, args)

    raw_remaining = getattr(args, "raw_cmd_data_remaining", 0)
    if raw_remaining:
        take = min(raw_remaining, len(data))
        args.raw_cmd_data_parts.append(data[:take])
        args.raw_cmd_data_remaining = raw_remaining - take
        log("cmd_data",
            f"command={args.raw_cmd_data_command} len={take} "
            f"remaining={args.raw_cmd_data_remaining}")
        if args.raw_cmd_data_remaining == 0:
            payload = b"".join(args.raw_cmd_data_parts)
            preview = payload[:64].hex()
            if len(payload) > 64:
                preview += "..."
            log("cmd_data",
                f"command={args.raw_cmd_data_command} total={len(payload)} "
                f"hex={preview} words_head={words_head(payload)}")
            if args.raw_cmd_data_command == SAHARA_COMMAND_SUPPORTED_COMMANDS:
                for command in words(payload):
                    queue_cmd_exec(args, command)
            args.raw_cmd_data_parts = []
            run_next_cmd_or_switch(fd, args)
        if len(data) > take:
            raise RuntimeError("command data read exceeded expected length")
        return "progress", 0

    packet_words = words(data)
    cmd = packet_words[0] if packet_words else 0
    pkt_len = packet_words[1] if len(packet_words) > 1 else len(data)
    log("rx", f"len={len(data)} cmd={cmd} pkt_len={pkt_len} words={packet_words[:12]}")

    if cmd == CMD_HELLO:
        if len(data) < HELLO_LEN or pkt_len != HELLO_LEN:
            raise RuntimeError("short or malformed HELLO")
        send_hello_resp(fd, packet_words, args)
        return "progress", 0

    if cmd == CMD_READ_DATA:
        if len(packet_words) < 5:
            raise RuntimeError("short READ_DATA")
        image, offset, length = packet_words[2], packet_words[3], packet_words[4]
        return "progress", send_image_range(fd, image, offset, length, args)

    if cmd == CMD_END_IMAGE:
        image = packet_words[2] if len(packet_words) > 2 else None
        status = packet_words[3] if len(packet_words) > 3 else None
        log("end_image", f"image={image} status={status}")
        if status == 0:
            send_done(fd, args)
            return "progress", 0
        return "stop", 0

    if cmd == CMD_DONE_RESP:
        pending = packet_words[2] if len(packet_words) > 2 else None
        if pending == 0:
            meaning = "pending"
        elif pending == 1:
            meaning = "complete"
        else:
            meaning = "unknown"
        log("done_resp", f"image_tx_pending={pending} meaning={meaning}")
        if pending == 1:
            return "stop", 0
        return "progress", 0

    if cmd in (CMD_MEMORY_DEBUG, CMD_MEMORY_DEBUG64):
        if cmd == CMD_MEMORY_DEBUG:
            if len(packet_words) < 4:
                raise RuntimeError("short MEMORY_DEBUG")
            address, length = packet_words[2], packet_words[3]
            args.memory_is64 = False
        else:
            if len(data) < 24:
                raise RuntimeError("short MEMORY_DEBUG64")
            address, length = struct.unpack_from("<QQ", data, 8)
            args.memory_is64 = True

        log("mem_debug",
            f"table_address=0x{address:x} table_length={length} is64={args.memory_is64}")
        args.memory_table_remaining = length
        args.memory_table_parts = []
        send_memory_read(fd, address, length, args.memory_is64, args)
        return "progress", 0

    if cmd == CMD_RESET_RESP:
        log("reset_resp", "received")
        return "stop", 0

    if cmd == CMD_CMD_READY:
        args.switch_after_cmds = True
        args.command_switch_sent = False
        queue_cmd_exec(args, SAHARA_COMMAND_SUPPORTED_COMMANDS)
        run_next_cmd_or_switch(fd, args)
        return "progress", 0

    if cmd == CMD_EXEC_RESP:
        command = packet_words[2] if len(packet_words) > 2 else args.current_cmd_exec
        resp_len = packet_words[3] if len(packet_words) > 3 else 0
        log("cmd_exec_resp", f"command={command} response_len={resp_len}")
        if resp_len:
            args.raw_cmd_data_command = command
            args.raw_cmd_data_remaining = resp_len
            args.raw_cmd_data_parts = []
            send_cmd_exec_data(fd, command, args)
        else:
            run_next_cmd_or_switch(fd, args)
        return "progress", 0

    raise RuntimeError(f"unsupported Sahara cmd {cmd}")


def trigger_dump(args):
    if not args.dump_on_idle:
        return
    try:
        with open(args.dump_path, "w") as fp:
            fp.write("1")
        log("dump", f"triggered via {args.dump_path}")
    except OSError as exc:
        log("dump", f"trigger failed: {exc}")


def reset_session_state(args):
    args.cmd_exec_queue = []
    args.cmd_exec_counts = {}
    args.current_cmd_exec = None
    args.switch_after_cmds = False
    args.command_switch_sent = False
    args.memory_is64 = False
    args.memory_table_remaining = 0
    args.memory_table_parts = []
    args.memory_entries = []
    args.memory_current = None
    args.memory_region_remaining = 0
    args.raw_cmd_data_command = None
    args.raw_cmd_data_remaining = 0
    args.raw_cmd_data_parts = []


def run_session(args, index):
    flags = os.O_RDWR | os.O_NONBLOCK
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC

    log("session", f"{index} open {args.dev}")
    fd = os.open(args.dev, flags)
    packets = 0
    sent = 0
    reset_session_state(args)
    try:
        while args.max_packets <= 0 or packets < args.max_packets:
            data = read_packet(fd, args.idle_timeout, args.read_size)
            if not data:
                if args.persist:
                    # Persistent EFS-sync responder (Android `ks -t -1`):
                    # never idle-exit, keep the pipe open waiting for the
                    # modem's next memory-debug HELLO.
                    continue
                log("session", f"{index} idle packets={packets} bytes_sent={sent}")
                trigger_dump(args)
                return packets, sent, "idle"
            action, bytes_sent = handle_packet(fd, data, args)
            packets += 1
            sent += bytes_sent
            if args.max_bytes > 0 and sent >= args.max_bytes:
                log("session", f"{index} max_bytes={sent}")
                return packets, sent, "max_bytes"
            if action == "stop":
                if args.persist:
                    # A sync (RESET_RESP) or image round finished; re-arm on the
                    # SAME fd for the modem's next memory-debug session.
                    log("persist", f"sync round done (packets={packets}); re-arming")
                    reset_session_state(args)
                    continue
                return packets, sent, "stop"
        return packets, sent, "max_packets"
    finally:
        os.close(fd)
        log("session", f"{index} close")


def parse_args():
    parser = argparse.ArgumentParser()
    parser.add_argument("--dev", default="/dev/mhi_pipe_2")
    parser.add_argument("--firmware-dir", default="/lib/firmware/qcom/sdx50m")
    parser.add_argument("--sessions", type=int, default=12)
    parser.add_argument("--idle-timeout", type=float, default=10.0)
    parser.add_argument("--between-sessions", type=float, default=1.0)
    parser.add_argument("--read-size", type=int, default=4096)
    parser.add_argument("--chunk-size", type=int, default=0x100000)
    parser.add_argument("--write-timeout", type=float, default=30.0)
    parser.add_argument("--hello-compat", type=int, default=-1,
                        help="HELLO_RESP compatible version, default echoes device HELLO")
    parser.add_argument("--hello-mode", type=int, default=-1,
                        help="HELLO_RESP mode, default echoes device HELLO")
    parser.add_argument("--max-request", type=int, default=0x100000)
    parser.add_argument("--max-packets", type=int, default=0)
    parser.add_argument("--max-bytes", type=int, default=0)
    parser.add_argument("--max-cmd-queue", type=int, default=7,
                        help="Maximum queued Sahara CMD_EXEC commands, matching ks")
    parser.add_argument("--max-cmd-execs", type=int, default=32,
                        help="Safety limit for repeated execution of one CMD_EXEC command")
    parser.add_argument("--dump-on-idle", action="store_true",
                        help="Trigger MHI SAHARA state dump on idle timeout")
    parser.add_argument("--dump-path",
                        default="/sys/module/mhi_sahara/parameters/dump")
    parser.add_argument("--mem-dump-dir", default="/var/lib/x50-modem/efs")
    parser.add_argument("--mem-prefix", default="")
    parser.add_argument("--reset-after-memory", action=argparse.BooleanOptionalAction,
                        default=True)
    parser.add_argument("--persist", action="store_true",
                        help="Persistent EFS-sync responder: keep the pipe open "
                             "forever, never idle/stop-exit, re-arm after each "
                             "memory-debug sync (equivalent to Android ks -t -1). "
                             "Reopens the device if it goes away.")
    parser.add_argument("--reopen-delay", type=float, default=2.0,
                        help="In --persist mode, seconds to wait before reopening "
                             "the device after an error/close")
    return parser.parse_args()


def main():
    args = parse_args()
    for image, name in sorted(IMAGE_FILES.items()):
        path = os.path.join(args.firmware_dir, name)
        log("map", f"image={image} file={name} size={os.path.getsize(path)}")

    if args.persist:
        # Run forever: keep a responder on the pipe across device
        # disappear/reappear. run_session() itself never returns in persist
        # mode except by raising (e.g. device gone), so reopen on error.
        index = 0
        while True:
            index += 1
            try:
                run_session(args, index)
            except Exception as exc:  # noqa: BLE001 - keep the daemon alive
                log("persist", f"session {index} error {exc!r}; reopen in {args.reopen_delay}s")
            time.sleep(args.reopen_delay)

    total_packets = 0
    total_sent = 0
    for index in range(1, args.sessions + 1):
        packets, sent, reason = run_session(args, index)
        total_packets += packets
        total_sent += sent
        if reason in ("stop", "max_bytes", "max_packets"):
            break
        if index != args.sessions and args.between_sessions > 0:
            time.sleep(args.between_sessions)
    log("summary", f"packets={total_packets} bytes_sent={total_sent}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        log("fatal", repr(exc))
        raise
