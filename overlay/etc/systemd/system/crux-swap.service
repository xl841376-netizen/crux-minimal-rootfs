[Unit]
Description=crux swap: zram 4G (zstd) + 可选 8G swapfile on linux-root
# 注意：8G swapfile 那部分由 /etc/crux-swap.conf 的 LROOT_SWAP 开关控制，默认关闭。
#       关闭时本服务只建 zram，完全不需要第二块盘；因此这里不写
#       Wants=mnt-lroot.mount / ExecStartPre 挂载，避免默认路径上非挂不可。
After=local-fs.target systemd-modules-load.service
Before=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/crux-swap-setup.sh

[Install]
WantedBy=multi-user.target
