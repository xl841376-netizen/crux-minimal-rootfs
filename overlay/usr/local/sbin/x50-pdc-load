#!/usr/bin/env python3
# x50-pdc-load: 按 libqmi 的规则（Config ID = SHA1(文件内容), chunk=1024）通过 L4 直发 PDC
#   Load Config 0x26 -> 等 indication(0x12 remaining) -> 循环
#   Activate Config 0x27 (type=software)
# 用法: x50-pdc-load.py <mbn文件> [--activate]
import hashlib, json, os, struct, sys, time

CMD = "/run/x50-l4.cmd"
STATE = "/run/x50-l4.json"
SVC = 36
CHUNK = 1024


def tlv(tid, val):
    return bytes([tid]) + struct.pack("<H", len(val)) + val


def load_state():
    for _ in range(20):
        try:
            with open(STATE) as f:
                return json.load(f)
        except Exception:
            time.sleep(0.2)
    return None


def snapshot(msg):
    st = load_state()
    seen = set()
    if st:
        for e in st.get("indications") or []:
            if e.get("service") == "pdc" and e.get("msg") == msg:
                seen.add((int(e.get("ts") or 0), str(e.get("tlvs"))))
    return seen


def send(hexpayload, msg, wait=15.0):
    if os.path.exists(CMD):
        try:
            os.remove(CMD)
        except OSError:
            pass
    base = snapshot(msg)
    with open(CMD, "w") as f:
        f.write(hexpayload)
    t0 = time.time()
    while time.time() - t0 < wait:
        st = load_state()
        if st:
            for e in reversed(st.get("indications") or []):
                if e.get("service") != "pdc" or e.get("msg") != msg:
                    continue
                key = (int(e.get("ts") or 0), str(e.get("tlvs")))
                if key not in base:
                    return e
        time.sleep(0.2)
    return None


def main():
    if len(sys.argv) < 2:
        print("usage: x50-pdc-load.py <mbn> [--activate]")
        return 2
    path = sys.argv[1]
    do_act = "--activate" in sys.argv
    data = open(path, "rb").read()
    total = len(data)
    cid = hashlib.sha1(data).digest()
    print("[file]", path)
    print("[size]", total, "[config_id(sha1)]", cid.hex())
    off = 0
    n = 0
    while off < total:
        chunk = data[off:off + CHUNK]
        body = struct.pack("<I", 1)                    # type = SOFTWARE
        body += bytes([len(cid)]) + cid
        body += struct.pack("<I", total)
        body += struct.pack("<H", len(chunk)) + chunk
        t = tlv(0x01, body) + tlv(0x10, struct.pack("<I", 0x50444301))
        payload = "%d 0026 %s" % (SVC, t.hex())
        ind = send(payload, 0x26, wait=45)
        n += 1
        if not ind:
            print("[chunk %d] no indication (off=%d)" % (n, off))
            return 3
        tlvs = {int(a): b for a, b in ind.get("tlvs") or []}
        res = tlvs.get(0x01, "")
        remaining = None
        if 0x12 in tlvs:
            b = bytes.fromhex(tlvs[0x12])
            remaining = struct.unpack("<I", b[:4])[0] if len(b) >= 4 else None
        print("[chunk %d] off=%d res=%s remaining=%s tlvs=%s" % (n, off, res, remaining, ind.get("tlvs")))
        if remaining == 0:
            break
        if remaining is None:
            return 4
        off = total - remaining
    print("[load] done chunks=%d" % n)
    if do_act:
        a = tlv(0x01, struct.pack("<I", 1))
        print("[activate]", "(sent)")
        send("%d 0027 %s" % (SVC, a.hex()), 0x27, wait=30)
    return 0


if __name__ == "__main__":
    sys.exit(main())