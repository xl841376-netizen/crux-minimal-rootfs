#!/usr/bin/env python3
# x50-pdc-apply: 开机自动完成 PDC 的 MBN 选择/加载/激活（等价原厂 qcril_mbn 行为）
#   1) 等 L4(PDC 客户端) 与 UIM 就绪
#   2) 读卡 IMSI -> 运营商 -> 按目录优先级挑 mcfg_sw.mbn
#   3) 已在模组且 Active 则跳过；在但 Inactive 则直接激活；不在则分片上传
#   4) Set Selected Config(0x23) -> Activate Config(0x27)
# Config ID 规则：SHA1(文件内容) 20B, chunk=1024, Load=0x26 (带 Token TLV0x10)
import hashlib, json, os, re, struct, subprocess, sys, time

CMD = "/run/x50-l4.cmd"
STATE = "/run/x50-l4.json"
LOG = "/var/log/x50-pdc.log"
QRTR = "qrtr://0"
SVC = 36
CHUNK = 1024
TOKEN = 0x50444301
BASE = "/lib/firmware/qcom/sdx50m/modem_pr/mcfg/configs/mcfg_sw/generic"

OP_MAP = [
    (("46000", "46002", "46004", "46007", "46008"), "cmcc"),
    (("46001", "46006", "46009"), "cu"),
    (("46003", "46005", "46011"), "ct"),
]
PREF = [
    "commerci/volte_op/mcfg_sw.mbn",
    "commerci/openmkt/mcfg_sw.mbn",
    "commerci/hvolte_o/mcfg_sw.mbn",
    "commerci/volte_co/mcfg_sw.mbn",
]


def log(m):
    line = "%s %s" % (time.strftime("%F %T"), m)
    try:
        with open(LOG, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass
    print(line, flush=True)


def sh(args, timeout=40):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout or "") + (p.stderr or "")
    except Exception as e:
        return 1, "%s: %s" % (type(e).__name__, e)


def state():
    for _ in range(10):
        try:
            with open(STATE) as f:
                return json.load(f)
        except Exception:
            time.sleep(0.3)
    return None


def wait_l4(limit=300):
    t0 = time.time()
    while time.time() - t0 < limit:
        st = state()
        if st and "pdc" in (st.get("services") or {}):
            return True
        time.sleep(3)
    return False


def uim_ready():
    st = state() or {}
    cards = ((st.get("services") or {}).get("uim") or {}).get("cards") or {}
    for c in cards.get("cards") or []:
        for a in c.get("apps") or []:
            if a.get("state") == 7:
                return True
    return False


def wait_uim(limit=240):
    t0 = time.time()
    while time.time() - t0 < limit:
        if uim_ready():
            return True
        time.sleep(5)
    return False


def tlv(tid, val):
    return bytes([tid]) + struct.pack("<H", len(val)) + val


def snapshot(msg):
    st = state() or {}
    seen = set()
    for e in st.get("indications") or []:
        if e.get("service") == "pdc" and e.get("msg") == msg:
            seen.add((int(e.get("ts") or 0), str(e.get("tlvs"))))
    return seen


def send(payload, msg, wait=45.0):
    if os.path.exists(CMD):
        try:
            os.remove(CMD)
        except OSError:
            pass
    base = snapshot(msg)
    with open(CMD, "w") as f:
        f.write(payload)
    t0 = time.time()
    while time.time() - t0 < wait:
        st = state()
        if st:
            for e in reversed(st.get("indications") or []):
                if e.get("service") != "pdc" or e.get("msg") != msg:
                    continue
                if (int(e.get("ts") or 0), str(e.get("tlvs"))) not in base:
                    return e
        time.sleep(0.2)
    return None


def read_imsi():
    rc, out = sh(["qmicli", "-d", QRTR, "--uim-read-transparent=0x3F00,0x7FFF,0x6F07"], 30)
    hexs = ""
    for ln in out.splitlines():
        ln = ln.strip()
        if re.fullmatch(r"([0-9a-fA-F]{2}:)+[0-9a-fA-F]{2}", ln):
            hexs = ln.replace(":", "")
    if not hexs:
        return None
    b = bytes.fromhex(hexs)
    body = b[1:] if b and b[0] == len(b) - 1 else b
    return "".join("%X%X" % (x & 0x0F, x >> 4) for x in body)


def pick(imsi):
    op = None
    for codes, name in OP_MAP:
        if imsi and any(c in imsi for c in codes):
            op = name
            break
    cands = []
    if op:
        d = os.path.join(BASE, "china", op)
        for rel in PREF:
            p = os.path.join(d, rel)
            if os.path.isfile(p):
                cands.append(p)
        if os.path.isdir(d):
            for root, _dn, fn in os.walk(d):
                if "commerci" in root and "mcfg_sw.mbn" in fn:
                    p = os.path.join(root, "mcfg_sw.mbn")
                    if p not in cands:
                        cands.append(p)
    dflt = os.path.join(BASE, "common/default/sm8150.p/default/mcfg_sw.mbn")
    if os.path.isfile(dflt):
        cands.append(dflt)
    return op, cands


def list_sw():
    rc, out = sh(["qmicli", "-d", QRTR, "--pdc-list-configs=software"], 30)
    return out


def is_active(text, cid_hex):
    """按 Configuration 分块解析：块内 ID 匹配则看该块的 Status"""
    want = ":".join(cid_hex[i:i + 2] for i in range(0, len(cid_hex), 2)).upper()
    for blk in re.split(r"Configuration\s+\d+\s*:", text):
        m = re.search(r"ID:\s*([0-9A-Fa-f:]+)", blk)
        if not m:
            continue
        if m.group(1).strip().upper().startswith(want[:8]):
            return bool(re.search(r"Status:\s*Active", blk, re.I))
    return False


def load_file(path, data, cid):
    total = len(data)
    off = 0
    n = 0
    while off < total:
        chunk = data[off:off + CHUNK]
        body = struct.pack("<I", 1)
        body += bytes([len(cid)]) + cid
        body += struct.pack("<I", total)
        body += struct.pack("<H", len(chunk)) + chunk
        t = tlv(0x01, body) + tlv(0x10, struct.pack("<I", TOKEN))
        ind = send("%d 0026 %s" % (SVC, t.hex()), 0x26)
        n += 1
        if not ind:
            log("[load] no indication at off=%d" % off)
            return False
        tlvs = {int(a): b for a, b in ind.get("tlvs") or []}
        rem = None
        if 0x12 in tlvs:
            bb = bytes.fromhex(tlvs[0x12])
            rem = struct.unpack("<I", bb[:4])[0] if len(bb) >= 4 else None
        if rem == 0:
            log("[load] done chunks=%d" % n)
            return True
        if rem is None:
            log("[load] no remaining tlv")
            return False
        off = total - rem
    return True


def set_selected(cid):
    body = struct.pack("<I", 1) + bytes([len(cid)]) + cid
    t = tlv(0x01, body)
    ind = send("%d 0023 %s" % (SVC, t.hex()), 0x23, wait=30)
    log("[set_selected] %s" % ("ok" if ind else "no-ind"))
    return bool(ind)


def activate():
    t = tlv(0x01, struct.pack("<I", 1))
    ind = send("%d 0027 %s" % (SVC, t.hex()), 0x27, wait=40)
    log("[activate] %s" % ("ok" if ind else "no-ind"))
    return bool(ind)


def main():
    force = "--force" in sys.argv
    log("=== x50-pdc-apply start ===")
    if not wait_l4():
        log("[fatal] L4/PDC not ready")
        return 2
    if not wait_uim():
        log("[warn] UIM not ready, try anyway")
    imsi = read_imsi()
    log("[imsi] %s" % imsi)
    op, cands = pick(imsi)
    log("[operator] %s" % (op or "unknown"))
    if not cands:
        log("[fatal] no candidate")
        return 3
    target = cands[0]
    data = open(target, "rb").read()
    cid = hashlib.sha1(data).digest()
    cid_hex = cid.hex()
    log("[target] %s size=%d id=%s" % (target, len(data), cid_hex))

    txt = list_sw()
    if not force and is_active(txt, cid_hex):
        log("[skip] already active")
        return 0
    if force or cid_hex not in txt.replace(":", "").lower():
        if not load_file(target, data, cid):
            return 4
    if not set_selected(cid):
        log("[warn] set_selected failed, continue")
    if not activate():
        return 5
    tail = list_sw()
    ok = is_active(tail, cid_hex)
    log("[result] active=%s" % ok)
    return 0 if ok else 6


if __name__ == "__main__":
    sys.exit(main())